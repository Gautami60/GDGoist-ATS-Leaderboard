# ===============================
# Database
# ===============================
MONGODB_URI=mongodb://127.0.0.1:27017/ats_leaderboard

# ===============================
# Authentication
# ===============================
JWT_SECRET=dev_jwt_secret_12345

# Optional – restrict registrations to a domain
# Example: @uni.edu
UNIVERSITY_DOMAIN=

# ===============================
# AWS / S3 (required for resume uploads)
# ===============================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev
S3_BUCKET=dev-bucket